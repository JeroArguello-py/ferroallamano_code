# Copia este archivo como `.env` y rellena los valores reales.
# El archivo .env está en .gitignore para que NUNCA se suba al repositorio.

# Cadena de conexión a MongoDB (Atlas o local).
# Ejemplo Atlas:   mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/ferroallamano?retryWrites=true&w=majority&appName=Cluster0
# Ejemplo local:   mongodb://127.0.0.1:27017/ferroallamano
MONGODB_URI=

# Puerto del servidor Express
PORT=3000
