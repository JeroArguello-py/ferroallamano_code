<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FerroAllamano - Factura</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/factura.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
</head>
<body>
    <div class="main-wrapper">
        <aside class="sidebar">
            <div class="sidebar-top">
                <div class="logo-container">
                    <span class="logo-main">FERROALLAMANO</span>
                    <span class="logo-sub">facturación</span>
                </div>
                <nav class="sidebar-nav">
                    <a href="/productos" class="nav-item">
                        <i class="fa-solid fa-box-open"></i>
                        <span>Productos</span>
                    </a>
                    <a href="/ventas/nueva" class="nav-item active">
                        <i class="fa-solid fa-money-bill-transfer"></i>
                        <span>Módulo de Ventas</span>
                    </a>
                    <a href="/ventas/historial" class="nav-item">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>Historial</span>
                    </a>
                </nav>
            </div>
            <div class="sidebar-bottom">
                <button class="btn-sidebar-alt" type="button" onclick="window.location.href='/dashboard'">+ Dashboard</button>
            </div>
        </aside>

        <main class="main-content">
            <% if (!factura) { %>
                <div class="dashboard-area">
                    <div class="factura-error">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <h2>No se pudo cargar la factura</h2>
                        <p><%= error || 'Factura no encontrada.' %></p>
                        <button class="btn-emit" onclick="window.location.href='/ventas/nueva'">Volver a Ventas</button>
                    </div>
                </div>
            <% } else {
                const empresa = {
                    nombre: 'FERROALLAMANO S.A.S.',
                    eslogan: 'Suministros industriales y ferretería',
                    nit: '900.123.456-7',
                    direccion: 'Ak 68 #1-63, Bogotá D.C.',
                    telefono: '+57 320 407 1924',
                    correo: 'contacto@ferroallamano.com'
                };
                const money = (n) => '$ ' + (Number(n) || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const d = new Date(factura.fechaEmision);
                const meses = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
                const fechaFmt = isNaN(d) ? '—' : `${String(d.getDate()).padStart(2,'0')} ${meses[d.getMonth()]} ${d.getFullYear()}`;
                const emitida = factura.estadoFactura === 'emitida';
                const pagado = factura.estadoPago === 'pagado';
                const cli = factura.clienteSnapshot || {};
                const ivaPct = Math.round((factura.ivaRate || 0.19) * 100);
            %>
            <div class="dashboard-area" data-factura-id="<%= factura.id %>" data-codigo="<%= factura.codigoFactura %>">

                <%# ── Barra de acciones (no se incluye en el PDF) ─────────── %>
                <div class="factura-actionbar">
                    <div class="ab-titles">
                        <h1>Factura</h1>
                        <p>Revisión y emisión de comprobante fiscal.</p>
                    </div>
                    <div class="ab-actions">
                        <button class="btn-pdf" id="btnDescargarPdf">
                            <i class="fa-solid fa-download"></i> Descargar PDF
                        </button>
                        <button class="btn-emit" id="btnEmitir" <%= emitida ? 'disabled' : '' %>>
                            <i class="fa-solid fa-file-invoice"></i>
                            <span id="btnEmitirText"><%= emitida ? 'Factura Emitida' : 'Emitir Factura' %></span>
                        </button>
                    </div>
                </div>

                <%# ── Hoja de factura (esto es lo que se exporta a PDF) ───── %>
                <div class="invoice-sheet" id="facturaPrintable">

                    <header class="inv-header">
                        <div class="inv-brand">
                            <div class="inv-logo">FA</div>
                            <div class="inv-brand-text">
                                <h2><%= empresa.nombre %></h2>
                                <p><%= empresa.eslogan %></p>
                            </div>
                        </div>
                        <div class="inv-meta">
                            <span class="inv-doc-type">FACTURA</span>
                            <p class="inv-codigo"><%= factura.codigoFactura %></p>
                            <span class="badge <%= emitida ? 'badge-green' : 'badge-yellow' %>" id="badgeFactura">
                                <i class="fa-solid <%= emitida ? 'fa-circle-check' : 'fa-pen-ruler' %>"></i>
                                <%= emitida ? 'Emitida' : 'Borrador' %>
                            </span>
                        </div>
                    </header>

                    <div class="inv-accent-bar"></div>

                    <section class="inv-parties">
                        <div class="inv-party">
                            <span class="inv-party-label">Emisor</span>
                            <p class="inv-party-name"><%= empresa.nombre %></p>
                            <p>NIT: <%= empresa.nit %></p>
                            <p><%= empresa.direccion %></p>
                            <p><%= empresa.telefono %></p>
                            <p><%= empresa.correo %></p>
                        </div>
                        <div class="inv-party">
                            <span class="inv-party-label">Facturar a</span>
                            <p class="inv-party-name"><%= cli.nombre || 'Cliente sin nombre' %></p>
                            <p>Doc: <%= cli.documento || '—' %></p>
                            <% if (cli.direccion) { %><p><%= cli.direccion %></p><% } %>
                            <% if (cli.telefono) { %><p><%= cli.telefono %></p><% } %>
                            <p><%= cli.correo || '—' %></p>
                        </div>
                        <div class="inv-party inv-party-data">
                            <div class="inv-data-row">
                                <span>Cód. Venta</span>
                                <strong><%= factura.codigoVenta || '—' %></strong>
                            </div>
                            <div class="inv-data-row">
                                <span>Fecha de emisión</span>
                                <strong><%= fechaFmt %></strong>
                            </div>
                            <div class="inv-data-row">
                                <span>Estado de pago</span>
                                <span class="badge <%= pagado ? 'badge-green' : 'badge-gray' %>" id="badgePago">
                                    <i class="fa-regular <%= pagado ? 'fa-circle-check' : 'fa-clock' %>"></i>
                                    <%= pagado ? 'Pagado' : 'Pendiente' %>
                                </span>
                            </div>
                        </div>
                    </section>

                    <table class="inv-table">
                        <thead>
                            <tr>
                                <th class="col-cod">CÓD.</th>
                                <th>DESCRIPCIÓN</th>
                                <th class="col-c">CANT.</th>
                                <th class="col-r">PRECIO UNIT.</th>
                                <th class="col-r">IMPORTE</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!factura.items || factura.items.length === 0) { %>
                                <tr><td colspan="5" class="inv-empty">Esta factura no tiene ítems.</td></tr>
                            <% } else { factura.items.forEach(function(it) { %>
                                <tr>
                                    <td class="col-cod"><%= it.sku || '—' %></td>
                                    <td>
                                        <span class="inv-item-name"><%= it.nombre %></span>
                                        <% if (it.descripcion) { %><span class="inv-item-desc"><%= it.descripcion %></span><% } %>
                                    </td>
                                    <td class="col-c"><%= it.cantidad %></td>
                                    <td class="col-r"><%= money(it.precioUnitario) %></td>
                                    <td class="col-r inv-item-total"><%= money(it.subtotal) %></td>
                                </tr>
                            <% }); } %>
                        </tbody>
                    </table>

                    <section class="inv-summary">
                        <div class="inv-notes">
                            <% if (factura.notas) { %>
                                <span class="inv-notes-label">Notas</span>
                                <p><%= factura.notas %></p>
                            <% } %>
                        </div>
                        <div class="inv-totals">
                            <div class="inv-total-row">
                                <span>Subtotal</span>
                                <span><%= money(factura.subtotal) %></span>
                            </div>
                            <div class="inv-total-row">
                                <span>Descuento<%= factura.descuentoPorcentaje ? ' (' + factura.descuentoPorcentaje + '%)' : '' %></span>
                                <span class="neg">-<%= money(factura.descuento) %></span>
                            </div>
                            <div class="inv-total-row">
                                <span>IVA (<%= ivaPct %>%)</span>
                                <span><%= money(factura.iva) %></span>
                            </div>
                            <div class="inv-total-grand">
                                <span>TOTAL A PAGAR</span>
                                <span><%= money(factura.total) %></span>
                            </div>
                        </div>
                    </section>

                    <footer class="inv-footer">
                        <p class="inv-thanks">Gracias por su compra.</p>
                        <p class="inv-legal">Documento generado electrónicamente por <%= empresa.nombre %>. Este comprobante es válido sin firma autógrafa.</p>
                    </footer>
                </div>
            </div>
            <% } %>
        </main>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"
        onerror="this.onerror=null;var s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js';document.head.appendChild(s);"></script>
    <script src="/js/factura.js"></script>
</body>
</html>
